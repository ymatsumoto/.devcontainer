{
  "name": "Claude Code (RHEL-based)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "shutdownAction": "none",

  "workspaceMount": "source=${localWorkspaceFolder},target=/root/work,type=bind",
  "workspaceFolder": "/root/work",

  "initializeCommand": {
    "claude":       "mkdir -p ${localWorkspaceFolder}/.container-home/claude",
    "claude-json":  "mkdir -p ${localWorkspaceFolder}/.container-home; [ -s ${localWorkspaceFolder}/.container-home/claude.json ] || echo '{}' > ${localWorkspaceFolder}/.container-home/claude.json",
    "ssh":          "mkdir -p ${localWorkspaceFolder}/.container-home/ssh && chmod 700 ${localWorkspaceFolder}/.container-home/ssh",
    "gh":           "mkdir -p ${localWorkspaceFolder}/.container-home/gh && chmod 700 ${localWorkspaceFolder}/.container-home/gh",
    "gitconfig":    "mkdir -p ${localWorkspaceFolder}/.container-home && touch ${localWorkspaceFolder}/.container-home/gitconfig",
    "bash-history": "mkdir -p ${localWorkspaceFolder}/.container-home && touch ${localWorkspaceFolder}/.container-home/bash_history"
  },

  "mounts": [
     "source=${localWorkspaceFolder}/.container-home/claude,target=/root/.claude,type=bind",
     "source=${localWorkspaceFolder}/.container-home/claude.json,target=/root/.claude.json,type=bind",
     "source=${localWorkspaceFolder}/.container-home/ssh,target=/root/.ssh,type=bind",
     "source=${localWorkspaceFolder}/.devcontainer/storage.conf,target=/etc/containers/storage.conf,type=bind"
  ],

  "runArgs": [
    "--privileged",
    "--device", "${localEnv:DEVCONTAINER_GPU:/dev/null}"
  ],

  "containerEnv": {
    "HISTFILE": "${containerWorkspaceFolder}/.container-home/bash_history",
    "TZ": "Asia/Tokyo"
  },

  "postCreateCommand": {
    "claude":       "curl -fsSL https://claude.ai/install.sh | bash",
    "ssh":          "chmod 700 ~/.ssh 2>/dev/null; chmod 600 ~/.ssh/* 2>/dev/null; chmod 644 ~/.ssh/*.pub ~/.ssh/known_hosts 2>/dev/null; true",
    "gh":           "mkdir -p ~/.config && ln -sfn ${containerWorkspaceFolder}/.container-home/gh ~/.config/gh",
    "gitconfig":    "ln -sf ${containerWorkspaceFolder}/.container-home/gitconfig ~/.gitconfig",
    "bashrc":       "ln -sf ${containerWorkspaceFolder}/.devcontainer/.bashrc ~/.bashrc",
    "tmux-conf":    "ln -sf ${containerWorkspaceFolder}/.devcontainer/.tmux.conf ~/.tmux.conf"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
