{
  "name": "Claude Code (RHEL-based)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "shutdownAction": "none",

  "workspaceMount": "source=${localWorkspaceFolder},target=/root/work,type=bind",
  "workspaceFolder": "/root/work",

  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.container-home/claude ${localWorkspaceFolder}/.container-home/ssh; chmod 700 ${localWorkspaceFolder}/.container-home/ssh; [ -e ${localWorkspaceFolder}/.container-home/claude.json ] || echo '{}' > ${localWorkspaceFolder}/.container-home/claude.json",

  "mounts": [
     "source=${localWorkspaceFolder}/.container-home/claude,target=/root/.claude,type=bind",
     "source=${localWorkspaceFolder}/.container-home/claude.json,target=/root/.claude.json,type=bind",
     "source=${localWorkspaceFolder}/.container-home/ssh,target=/root/.ssh,type=bind",
     "source=${localWorkspaceFolder}/.devcontainer/storage.conf,target=/etc/containers/storage.conf,type=bind"
  ],

  "runArgs": [
    "--privileged"
  ],

  "containerEnv": {
    "HISTFILE": "/root/work/.container-home/bash_history",
    "TZ": "Asia/Tokyo"
  },

  "postCreateCommand": {
    "claude-install": "curl -fsSL https://claude.ai/install.sh | bash",
    "bashrc": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.bashrc ~/.bashrc",
    "tmux-conf": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.tmux.conf ~/.tmux.conf",
    "gitconfig": "ln -sf ${containerWorkspaceFolder}/.container-home/gitconfig ~/.gitconfig",
    "gh-config": "mkdir -p ~/.config ${containerWorkspaceFolder}/.container-home/gh && ln -sfn ${containerWorkspaceFolder}/.container-home/gh ~/.config/gh",
    "ssh-perms": "chmod 700 ~/.ssh 2>/dev/null; chmod 600 ~/.ssh/* 2>/dev/null; chmod 644 ~/.ssh/*.pub ~/.ssh/known_hosts 2>/dev/null; true"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
