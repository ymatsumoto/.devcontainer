{
  "name": "Claude Code (RHEL-based)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "shutdownAction": "none",

  "workspaceMount": "source=${localWorkspaceFolder},target=/root/work,type=bind",
  "workspaceFolder": "/root/work",

  "mounts": [
     "source=claude-code-history,target=/root/.claude,type=volume"
  ],

  "runArgs": [
    "--privileged",
    "--dns=172.16.0.1",
    "--dns=172.16.2.3",
    "--dns-search=gie.internal"
  ],

  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "CODEX_NON_INTERACTIVE": "1"
  },

  "postCreateCommand": {
    "claude-install": "curl -fsSL https://claude.ai/install.sh | bash",
    "antigravity-install": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "codex-install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "bashrc": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.bashrc ~/.bashrc",
    "tmux-conf": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.tmux.conf ~/.tmux.conf",
    "profile": "touch ~/.profile"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
      ]
    }
  }
}
