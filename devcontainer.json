{
  "name": "Claude Code (RHEL-based)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "shutdownAction": "none",

  "workspaceMount": "source=${localWorkspaceFolder},target=/root/work,type=bind",
  "workspaceFolder": "/root/work",

  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.container-home/claude",

  "mounts": [
     "source=${localWorkspaceFolder}/.container-home/claude,target=/root/.claude,type=bind"
  ],

  "runArgs": [
    "--privileged",
    "--dns-search=gie.internal"
  ],

  "containerEnv": {
    "HISTFILE": "/root/work/.container-home/bash_history"
  },

  "postCreateCommand": {
    "claude-install": "curl -fsSL https://claude.ai/install.sh | bash",
    "bashrc": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.bashrc ~/.bashrc",
    "tmux-conf": "ln -sf ${containerWorkspaceFolder}/.devcontainer/.tmux.conf ~/.tmux.conf"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
