{
  "name": "Claude Code (RHEL-based)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "shutdownAction": "none",

  "workspaceMount": "source=${localWorkspaceFolder},target=/root/work,type=bind",
  "workspaceFolder": "/root/work",

  // Per-user, per-workspace state lives in the host home, not the workspace (see init.sh)
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/init.sh\" \"${localWorkspaceFolder}\" \"${localEnv:HOME}/.devcontainer-state\"",

  "mounts": [
     "source=${localEnv:HOME}/.devcontainer-state/.by-path${localWorkspaceFolder},target=/root/.state,type=bind",
     "source=${localEnv:HOME}/.devcontainer-state/.by-path${localWorkspaceFolder}/claude,target=/root/.claude,type=bind",
     "source=${localEnv:HOME}/.devcontainer-state/.by-path${localWorkspaceFolder}/claude.json,target=/root/.claude.json,type=bind",
     "source=${localEnv:HOME}/.devcontainer-state/.by-path${localWorkspaceFolder}/ssh,target=/root/.ssh,type=bind",
     "source=${localEnv:HOME}/.devcontainer-state/.by-path${localWorkspaceFolder}/gemini,target=/root/.gemini,type=bind",
     "source=${localWorkspaceFolder}/.devcontainer/storage.conf,target=/etc/containers/storage.conf,type=bind"
  ],

  "runArgs": [
    "--privileged",
    "--umask", "0002",
    "--device", "${localEnv:DEVCONTAINER_GPU:/dev/null}"
  ],

  "containerEnv": {
    "HISTFILE": "/root/.state/bash_history",
    "TZ": "Asia/Tokyo"
  },

  "postCreateCommand": {
    "claude":       "curl -fsSL https://claude.ai/install.sh | bash",
    "agy":          "h=$(mktemp -d) && curl -fsSL https://antigravity.google/cli/install.sh | HOME=$h bash -s -- --dir /root/.local/bin; r=$?; rm -rf $h; exit $r",
    "ssh":          "chmod 700 ~/.ssh 2>/dev/null; chmod 600 ~/.ssh/* 2>/dev/null; chmod 644 ~/.ssh/*.pub ~/.ssh/known_hosts 2>/dev/null; true",
    "gh":           "mkdir -p ~/.config && ln -sfn /root/.state/gh ~/.config/gh",
    "gitconfig":    "ln -sf /root/.state/gitconfig ~/.gitconfig",
    "bashrc":       "rm -f ~/.bashrc && echo '. ${containerWorkspaceFolder}/.devcontainer/.bashrc' > ~/.bashrc",
    "tmux-conf":    "ln -sf ${containerWorkspaceFolder}/.devcontainer/.tmux.conf ~/.tmux.conf",
    "stamp":        "cd ${containerWorkspaceFolder}/.devcontainer && cat devcontainer.json Dockerfile init.sh | sha256sum > /etc/devcontainer.stamp"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ymatsumoto43.knowledgewalk"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
